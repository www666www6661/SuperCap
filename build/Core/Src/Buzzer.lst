  38:Core/Inc/Buzzer.hpp **** }
  39:Core/Inc/Buzzer.hpp **** 
  40:Core/Inc/Buzzer.hpp **** /**
  41:Core/Inc/Buzzer.hpp ****  * @brief Play a tone
  42:Core/Inc/Buzzer.hpp ****  *
  43:Core/Inc/Buzzer.hpp ****  * @param frequency Frequency of the tone
  44:Core/Inc/Buzzer.hpp ****  * @param duration Duration of the tone
  45:Core/Inc/Buzzer.hpp ****  */
