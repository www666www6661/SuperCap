  52:Core/Inc/Buzzer.hpp ****     BUZZER_TIM.Instance->CNT                    = 0U;
  53:Core/Inc/Buzzer.hpp ****     __HAL_TIM_CLEAR_FLAG(&BUZZER_TIM, TIM_FLAG_UPDATE);
