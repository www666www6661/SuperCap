  29:Core/Inc/Buzzer.hpp ****  * @brief Play a tone
  30:Core/Inc/Buzzer.hpp ****  *
  31:Core/Inc/Buzzer.hpp ****  * @param frequency Frequency of the tone
  32:Core/Inc/Buzzer.hpp ****  */
  33:Core/Inc/Buzzer.hpp **** inline void play(uint32_t frequency)
  34:Core/Inc/Buzzer.hpp **** {
  35:Core/Inc/Buzzer.hpp ****     BUZZER_TIM.Instance->ARR                    = (uint32_t)(50000U / frequency) - 1U;
  36:Core/Inc/Buzzer.hpp ****     BUZZER_TIM.Instance->BUZZER_TIM_CHANNEL_CCR = BUZZER_TIM.Instance->ARR / 2U;
