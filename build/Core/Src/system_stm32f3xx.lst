  67              	.LVL0:
 223:Core/Src/system_stm32f3xx.c **** 
 224:Core/Src/system_stm32f3xx.c ****   /* Get SYSCLK source -------------------------------------------------------*/
 225:Core/Src/system_stm32f3xx.c ****   tmp = RCC->CFGR & RCC_CFGR_SWS;
  68              	 .loc 1 225 3 view .LVU6
  69              	 .loc 1 225 12 is_stmt 0 view .LVU7
  70 0000 134A     	 ldr r2,.L10
  71 0002 5368     	 ldr r3,[r2,#4]
  72              	.LVL1:
 226:Core/Src/system_stm32f3xx.c **** 
 227:Core/Src/system_stm32f3xx.c ****   switch (tmp)
  73              	 .loc 1 227 3 is_stmt 1 view .LVU8
 225:Core/Src/system_stm32f3xx.c **** 
  74              	 .loc 1 225 7 is_stmt 0 view .LVU9
  75 0004 03F00C03 	 and r3,r3,#12
