7152:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   * @brief  Start a burst DMA operation to update HRTIM control registers content
7153:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   * @param  hhrtim pointer to HAL HRTIM handle
7154:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   * @param  TimerIdx Timer index
7155:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *                   This parameter can be one of the following values:
7156:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_MASTER  for master timer
7157:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_A for timer A
7158:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_B for timer B
7159:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_C for timer C
7160:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_D for timer D
7161:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_E for timer E
7162:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_F for timer F
7163:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   * @param  BurstBufferAddress address of the buffer the HRTIM control registers
7164:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *                             content will be updated from.
7165:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   * @param  BurstBufferLength size (in WORDS) of the burst buffer.
7166:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   * @retval HAL status
7167:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   * @note The TimerIdx parameter determines the dma channel to be used by the
7168:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *       DMA burst controller (see below)
7169:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *       HRTIM_TIMERINDEX_MASTER: DMA channel 2 is used by the DMA burst controller
7170:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *       HRTIM_TIMERINDEX_TIMER_A: DMA channel 3 is used by the DMA burst controller
