7905:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c **** /** @defgroup HRTIM_Exported_Functions_Group10 Interrupts handling
7906:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *  @brief  Functions called when HRTIM generates an interrupt
7907:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *          7 interrupts can be generated by the master timer:
7908:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Master timer registers update
7909:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Synchronization event received
7910:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Master timer repetition event
7911:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Master Compare 1 to 4 event
7912:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *          14 interrupts can be generated by each timing unit:
7913:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Delayed protection triggered
7914:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Counter reset or roll-over event
7915:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Output 1 and output 2 reset (transition active to inactive)
7916:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Output 1 and output 2 set (transition inactive to active)
7917:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Capture 1 and 2 events
7918:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Timing unit registers update
7919:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Repetition event
7920:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Compare 1 to 4 event
7921:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *          8 global interrupts are generated for the whole HRTIM:
7922:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - System fault and Fault 1 to 5 (regardless of the timing unit attribution)
7923:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - DLL calibration done
7924:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c ****   *            - Burst mode period completed
7925:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_hrtim.c **** @verbatim
