 181:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c **** 
 182:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c **** /* Delay for COMP voltage scaler stabilization time.                          */
 183:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_comp.c **** /* Literal set to maximum value (refer to device datasheet,                   */
