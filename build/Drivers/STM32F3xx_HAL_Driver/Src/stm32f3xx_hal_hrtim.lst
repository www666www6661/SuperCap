 790:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c **** /**
 791:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @brief  Start the DLL calibration.
 792:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *         DLL ready interrupt is enabled
 793:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @param  hhrtim pointer to HAL HRTIM handle
 794:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @param  CalibrationRate DLL calibration period
 795:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    This parameter can be one of the following values:
 796:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_SINGLE_CALIBRATION: One shot DLL calibration
 797:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_CALIBRATIONRATE_7300: Periodic DLL calibration. T=7.300 ms
 798:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_CALIBRATIONRATE_910:  Periodic DLL calibration. T=0.910 ms
 799:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_CALIBRATIONRATE_114:  Periodic DLL calibration. T=0.114 ms
 800:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_CALIBRATIONRATE_14:   Periodic DLL calibration. T=0.014 ms
 801:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @retval HAL status
 802:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @note This function locks the HRTIM instance. HRTIM instance is unlocked
 803:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *       within the IRQ processing function when processing the DLL ready
 804:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *       interrupt.
 805:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @note If this function is called for periodic calibration, the DLLRDY
 806:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *       interrupt is generated every time the calibration completes which
 807:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *       will significantly increases the overall interrupt rate.
 808:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   */
