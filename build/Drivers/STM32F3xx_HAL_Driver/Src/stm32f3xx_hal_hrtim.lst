1328:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c **** /**
1329:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @brief  Configure an output in simple output compare mode
1330:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @param  hhrtim pointer to HAL HRTIM handle
1331:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @param  TimerIdx Timer index
1332:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   This parameter can be one of the following values:
1333:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_A for timer A
1334:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_B for timer B
1335:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_C for timer C
1336:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_D for timer D
1337:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_E for timer E
1338:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @param  OCChannel Timer output
1339:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    This parameter can be one of the following values:
1340:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TA1: Timer A - Output 1
1341:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TA2: Timer A - Output 2
1342:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TB1: Timer B - Output 1
1343:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TB2: Timer B - Output 2
1344:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TC1: Timer C - Output 1
1345:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TC2: Timer C - Output 2
1346:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TD1: Timer D - Output 1
1347:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TD2: Timer D - Output 2
1348:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TE1: Timer E - Output 1
1349:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TE2: Timer E - Output 2
1350:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @param  pSimpleOCChannelCfg pointer to the simple output compare output configuration structure
1351:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @note When the timer operates in simple output compare mode:
1352:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *         Output 1 is implicitly controlled by the compare unit 1
