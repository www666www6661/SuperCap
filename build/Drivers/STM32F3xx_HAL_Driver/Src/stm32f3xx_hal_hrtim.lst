1951:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   This parameter can be one of the following values:
1952:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_A for timer A
1953:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_B for timer B
1954:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_C for timer C
1955:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_D for timer D
1956:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                   @arg HRTIM_TIMERINDEX_TIMER_E for timer E
1957:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @param  PWMChannel Timer output
1958:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    This parameter can be one of the following values:
1959:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TA1: Timer A - Output 1
1960:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TA2: Timer A - Output 2
1961:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TB1: Timer B - Output 1
1962:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TB2: Timer B - Output 2
1963:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TC1: Timer C - Output 1
1964:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TC2: Timer C - Output 2
1965:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TD1: Timer D - Output 1
1966:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TD2: Timer D - Output 2
1967:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TE1: Timer E - Output 1
1968:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *                    @arg HRTIM_OUTPUT_TE2: Timer E - Output 2
1969:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @param  pSimplePWMChannelCfg pointer to the simple PWM output configuration structure
1970:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @note When the timer operates in simple PWM output mode:
1971:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *         Output 1 is implicitly controlled by the compare unit 1
1972:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *         Output 2 is implicitly controlled by the compare unit 2
1973:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *       Output Set/Reset crossbar is set as follows:
1974:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *         Output 1: SETx1R = CMP1, RSTx1R = PER
1975:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *         Output 2: SETx2R = CMP2, RST2R = PER
1976:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @note When Simple PWM mode is used the registers preload mechanism is
1977:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   *       enabled (otherwise the behavior is not guaranteed).
1978:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   * @retval HAL status
1979:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_hrtim.c ****   */
