 120:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c **** /* Status register needs up to 5 LSI clock periods divided by the clock
 121:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c ****    prescaler to be updated. The number of LSI clock periods is upper-rounded to
 122:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c ****    6 for the timeout value calculation.
 123:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c ****    The timeout value is calculated using the highest prescaler (256) and
 124:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c ****    the LSI_VALUE constant. The value of this constant can be changed by the user
 125:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c ****    to take into account possible LSI clock period variations.
 126:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c ****    The timeout value is multiplied by 1000 to be converted in milliseconds.
 127:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c ****    LSI startup time is also considered here by adding LSI_STARTUP_TIME
 128:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c ****    converted in milliseconds. */
 129:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c **** #define HAL_IWDG_DEFAULT_TIMEOUT        (((6UL * 256UL * 1000UL) / LSI_VALUE) + ((LSI_STARTUP_TIME 
 130:Drivers/STM32F3xx_HAL_Driver/Src/stm32f3xx_hal_iwdg.c **** #define IWDG_KERNEL_UPDATE_FLAGS        (IWDG_SR_WVU | IWDG_SR_RVU | IWDG_SR_PVU)
